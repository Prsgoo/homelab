# Komodo Core secrets - copy to /opt/komodo/komodo.env on CT 100
# Store the actual values in a password manager - needed for disaster recovery.

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=<generate: openssl rand -hex 32>

# Komodo Core
# KOMODO_PASSKEY: shared secret between Core and all Periphery agents
KOMODO_PASSKEY=<generate: openssl rand -hex 32>
# KOMODO_JWT_SECRET: signs session tokens - rotating this logs out all users
KOMODO_JWT_SECRET=<generate: openssl rand -hex 32>
